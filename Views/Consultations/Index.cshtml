@model List<Paper_Route.Models.Consultations.Consultation>
@{
    ViewData["Title"] = "Consultations";
    var types = ViewBag.ConsultationTypes as List<Paper_Route.Models.Consultations.ConsultationType> ?? new List<Paper_Route.Models.Consultations.ConsultationType>();
}

<h2 class="mb-3">Your Consultations</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#consultationModal">New Consultation</button>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Type</th>
            <th>When</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@(c.Type?.Name ?? "—")</td>
                <td>@c.ScheduledDateTime.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td>@c.Description</td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal: Create Consultation with slot picker -->
<div class="modal fade" id="consultationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post" id="consultationCreateForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">New Consultation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Type</label>
                            <select name="ConsultationTypeID" class="form-select" required>
                                <option value="">-- Select Type --</option>
                                @foreach (var t in types)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div>
                                <small class="text-muted">Select a day and then a time slot</small>
                            </div>
                        </div>
                    </div>

                    <!-- Date strip (next DAYS_AHEAD days) -->
                    <div class="mb-3">
                        <div id="dateStrip" class="d-flex gap-2 overflow-auto" aria-label="Available days">
                            <!-- JS injects date buttons here -->
                        </div>
                    </div>

                    <!-- Slot list -->
                    <div class="mb-3">
                        <h6 id="slotsTitle" class="mb-2">Available slots</h6>

                        <div id="slotsContainer" class="d-flex flex-wrap gap-2" aria-live="polite" aria-atomic="true">
                            <!-- JS injects slot buttons here -->
                        </div>

                        <div id="slotsEmpty" class="text-center text-muted mt-3" style="display:none;">
                            <div id="slotsEmptyMessage" class="mb-2">No available slots for this day.</div>
                            <button type="button" id="reloadSlotsBtn" class="btn btn-sm btn-outline-primary">Try another day</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" maxlength="500"></textarea>
                    </div>

                    <input type="hidden" id="SelectedSlotId" name="SelectedSlotId" />
                </div>

                <div class="modal-footer">
                    <div class="me-auto text-muted" id="selectionHint">No slot selected</div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="submitButton" class="btn btn-success" disabled>Book selected slot</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', () => {
          (function () {
            try {
              console.log('slot-picker script initialized');

              // Element references
              const modalEl = document.getElementById('consultationModal');
              if (!modalEl) {
                console.error('consultationModal not found in DOM');
                return;
              }

              const dateStrip = document.getElementById('dateStrip');
              const slotsContainer = document.getElementById('slotsContainer');
              const slotsEmpty = document.getElementById('slotsEmpty');
              const slotsEmptyMessage = document.getElementById('slotsEmptyMessage') || slotsEmpty;
              const slotsTitle = document.getElementById('slotsTitle');
              const selectedSlotIdInput = document.getElementById('SelectedSlotId');
              const submitButton = document.getElementById('submitButton');
              const selectionHint = document.getElementById('selectionHint');
              const reloadSlotsBtn = document.getElementById('reloadSlotsBtn');
              const form = document.getElementById('consultationCreateForm');
              const consultationTypeSelect = document.querySelector('select[name="ConsultationTypeID"]');


              // Config
              const DAYS_AHEAD = 14;
              const DATE_FORMAT_OPTIONS = { weekday: 'short', day: 'numeric', month: 'short' };

              // State
              let dateButtons = [];
              let currentFetchToken = 0;

              // Helpers
              function toYMD(date) {
                const y = date.getFullYear();
                const m = (date.getMonth() + 1).toString().padStart(2, '0');
                const d = date.getDate().toString().padStart(2, '0');
                return `${y}-${m}-${d}`;
              }

              // UI Builders
              function buildDateStrip() {
                dateButtons = [];
                dateStrip.innerHTML = '';

                const today = new Date();
                for (let i = 0; i < DAYS_AHEAD; i++) {
                  const d = new Date(today);
                  d.setDate(today.getDate() + i);

                  const btn = document.createElement('button');
                  btn.type = 'button';
                  btn.className = 'btn btn-outline-secondary text-nowrap';
                  btn.dataset.date = toYMD(d);
                  btn.setAttribute('aria-label', d.toLocaleDateString(undefined, DATE_FORMAT_OPTIONS));

                  const dow = d.getDay(); // 0 Sun .. 6 Sat
                  if (dow === 0 || dow === 6) {
                    btn.classList.add('text-muted');
                    btn.title = 'No working hours on weekends';
                    btn.dataset.weekend = '1';
                  }

                  const label = `${d.toLocaleDateString(undefined, DATE_FORMAT_OPTIONS)}`;
                  btn.innerHTML = `<div class="small">${label}</div><div class="fw-bold">${d.getDate()}</div>`;

                  btn.addEventListener('click', () => {
                    if (btn.dataset.weekend === '1') return;
                    onDateSelected(btn.dataset.date, btn);
                  });

                  dateStrip.appendChild(btn);
                  dateButtons.push(btn);
                }

                // auto-select first working day
                const first = dateButtons.find(b => b.dataset.weekend !== '1');
                if (first) {
                  selectDateButton(first);
                  fetchSlotsForDate(first.dataset.date).catch(console.error);
                }
              }

              function selectDateButton(btn) {
                dateButtons.forEach(b => {
                  b.classList.remove('btn-primary');
                  b.classList.add('btn-outline-secondary');
                });
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-primary');
              }

              async function onDateSelected(ymd, btn) {
                selectDateButton(btn);
                await fetchSlotsForDate(ymd);
              }

              // Slot Fetch
              async function fetchSlotsForDate(ymd) {
                try {
                  console.log('fetchSlotsForDate', ymd);
                  slotsContainer.innerHTML = '';
                  if (slotsEmpty) slotsEmpty.style.display = 'none';
                  slotsTitle.textContent = `Available slots — ${new Date(ymd).toLocaleDateString()}`;
                  if (selectionHint) selectionHint.textContent = 'No slot selected';
                  if (selectedSlotIdInput) selectedSlotIdInput.value = '';
                  if (submitButton) submitButton.disabled = true;

                  const token = ++currentFetchToken;
                  const url = `/Consultations/Available?date=${ymd}`;
                  slotsContainer.innerHTML = `
                    <div class="spinner-border text-secondary" role="status" style="width:1.2rem;height:1.2rem;">
                      <span class="visually-hidden">Loading...</span>
                    </div>`;

                  const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
                  if (token !== currentFetchToken) return; // stale response
                  if (!res.ok) {
                    const txt = await res.text();
                    throw new Error(`Failed to load slots: ${res.status} ${txt}`);
                  }

                  const payload = await res.json();
                  console.log('Available response', { ymd, payload });

                  const slots = Array.isArray(payload) ? payload : (payload.slots || []);
                  const message = Array.isArray(payload) ? null : payload.message;

                  slotsContainer.innerHTML = '';
                  const available = slots.filter(s => {
                    const st = (s.state ?? '').toString().toLowerCase();
                    return st === 'available' || st === '0';
                  });

                  if (available.length === 0) {
                    if (slotsEmpty) {
                      slotsEmpty.style.display = 'block';
                      slotsEmptyMessage.textContent = message || 'No available slots at the moment.';
                    }
                    return;
                  }

                  slots.sort((a, b) => new Date(a.startUtc) - new Date(b.startUtc));
                  for (const s of slots) {

                    const state = (s.state ?? '').toString().toLowerCase();
                    if (state === 'booked' || state === 'blocked'){}
                   
                    else{
                        const el = document.createElement('button');
                        el.type = 'button';
                        el.style.minWidth = '90px';
                        el.dataset.slotId = s.id;
                        el.dataset.startUtc = s.startUtc;
                        el.dataset.startLocal = s.startLocal;

                        el.className = 'btn btn-outline-success btn-sm';
                        el.addEventListener('click', () => onSlotSelected(s, el));

                        el.textContent = s.startLocal ?? new Date(s.startUtc).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        el.setAttribute('aria-label', `${el.textContent}, ${state}`);
                        slotsContainer.appendChild(el);
                        }
                  }

                } catch (err) {
                  console.error('fetchSlotsForDate error', err);
                  slotsContainer.innerHTML = '';
                  if (slotsEmpty) {
                    slotsEmpty.style.display = 'block';
                    slotsEmptyMessage.textContent = 'Could not load slots. Please try again later.';
                  }
                }
              }

              // Slot selection
              function onSlotSelected(slot, buttonEl) {
                const buttons = slotsContainer.querySelectorAll('button');
                buttons.forEach(b => b.classList.remove('btn-success', 'active'));
                buttonEl.classList.add('btn-success', 'active');

                if (selectedSlotIdInput) selectedSlotIdInput.value = slot.id;

                if(consultationTypeSelect.value)
                    if (submitButton) submitButton.disabled = false;

                if (selectionHint) selectionHint.textContent = `Selected ${slot.startLocal || ''}`;
              }

              // Type selection behavior
              if (consultationTypeSelect) {
                consultationTypeSelect.addEventListener('change', () => {
                  const hasType = consultationTypeSelect.value !== '';
                  selectedSlotIdInput.value = '';

                  if (hasType) {
                    buildDateStrip();
                  } 
                });
              }

              // Modal lifecycle
              modalEl.addEventListener('shown.bs.modal', () => {
                try {
                  console.log('modal shown — rebuilding date strip');
                  //buildDateStrip();
                } catch (e) {
                  console.error('error during shown.bs.modal handler', e);
                }
              });

              modalEl.addEventListener('hidden.bs.modal', () => {
                slotsContainer.innerHTML = '';
                dateStrip.innerHTML = '';
                consultationTypeSelect.value = '';
                if (selectedSlotIdInput) selectedSlotIdInput.value = '';
                if (submitButton) submitButton.disabled = true;
                if (slotsEmpty) slotsEmpty.style.display = 'none';
              });


              // Reload button
              if (reloadSlotsBtn) {
                reloadSlotsBtn.addEventListener('click', () => {
                  const active = dateButtons.find(b => b.classList.contains('btn-primary'));
                  if (active) fetchSlotsForDate(active.dataset.date).catch(console.error);
                });
              }

              // Form submit guard (only need slot ID now)
              if (form) {
                form.addEventListener('submit', e => {
                  if (!selectedSlotIdInput.value) {
                    e.preventDefault();
                    if (slotsEmptyMessage) {
                      slotsEmptyMessage.textContent = 'Please select a slot before booking.';
                      if (slotsEmpty) slotsEmpty.style.display = 'block';
                    } else {
                      alert('Please select a slot before booking.');
                    }
                  }
                });
              }

              // Dev helper
              window.__fetchSlotsForDate = fetchSlotsForDate;

            } catch (e) {
              console.error('slot-picker init failed', e);
            }
          })();
        });
    </script>

}

